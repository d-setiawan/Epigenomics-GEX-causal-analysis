  "method_contract": {
    "state_source": "held-out background features within each assay",
    "contexts": "full fit plus two disjoint background-feature folds",
    "base_union": "the target-safe v4.47 shared-state hypotheses",
    "model_universe": "reporter evidence remaining after only truth-blind v4.44 and v4.46 exclusions",
    "model_features": [
      "statistical_context_support_count",
      "global_reporter_coassignment_context_count",
      "maximum_reporter_pair_scaled_ks_ratio",
      "mean_coassigned_pair_exclusion_relative_margin"
    ],
    "model": "standardized L2 logistic regression with C=1 and balanced class weights",
    "nested_crossfit": "for each target block, train four models; each excludes both the target block and one out-of-fold calibration block",
    "conservative_target_score": "minimum probability across the four nested models",
    "empirical_null_threshold": "maximum null probability across the four corresponding out-of-fold calibration blocks",
    "selection": "strictly above the null envelope and only when every fold has the predeclared coefficient signs (+,+,-,+)",
    "leakage_guard": "non-target v4.47 selections are not used to define the model universe because their thresholds could depend on target-block truth",
    "conflict_handling": "merge selected assay pairs sharing an assay into one connected, unexpanded ambiguity hyperedge",
    "claim_scope": "shared-state equivalence only; never claim within-assay direct structure, exact cross-assay causal direction, or expansion of candidate alternatives"
  },
