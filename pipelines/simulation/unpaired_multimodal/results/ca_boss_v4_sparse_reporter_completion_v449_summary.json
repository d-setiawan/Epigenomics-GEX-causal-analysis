  "method_contract": {
    "state_source": "held-out background features within each assay",
    "reporter_candidates": "the three focal variables outside each assay's observed two-parent/one-child collider",
    "model_features": [
      "detected_fraction",
      "full_strength",
      "full_margin",
      "fold_min_strength",
      "fold_min_margin",
      "component_stable",
      "parent_component_match_count"
    ],
    "model": "standardize the seven fixed features, expand to degree-two interactions, then fit balanced logistic regression at C=0.1 and C=0.3",
    "nested_crossfit": "for each target block and regularization, train four models, each excluding the target and one out-of-fold calibration block",
    "empirical_null": "for each regularization, use the maximum probability assigned to an N1/N2 candidate in its corresponding out-of-fold calibration block",
    "reporter_selection": "both regularizations must strictly exceed their null envelopes and exactly one candidate may pass within an unresolved assay",
    "partner_selection": "exactly one already-supported assay reporter must be coassigned in all three synchronization contexts, have positive exclusion margins in every context, and have scaled KS ratio at most one in every context",
    "base_union": "the target-safe v4.48 shared-state hypotheses",
    "conflict_handling": "merge connected assay pairs into an unexpanded ambiguity hyperedge",
    "claim_scope": "shared-state equivalence only; never direct structure or cross-assay direction"
  },
