import Mathlib

/-! Finite rational identification core. The observed values include fixed guidance
and assay-local metadata. The model is post-selection; no selection transport is assumed. -/
namespace Epigenomics

structure Model where
  p00 : ℚ
  p01 : ℚ
  p10 : ℚ
  p11 : ℚ
  h00 : 0 ≤ p00
  h01 : 0 ≤ p01
  h10 : 0 ≤ p10
  h11 : 0 ≤ p11
  total : p00 + p01 + p10 + p11 = 1
  guidance : ℕ
  depthA : ℕ
  depthB : ℕ
  metadataA : ℕ
  metadataB : ℕ

def obs (m : Model) : ℚ × ℚ × ℕ × ℕ × ℕ × ℕ × ℕ :=
  (m.p10 + m.p11, m.p01 + m.p11, m.guidance, m.depthA, m.depthB, m.metadataA, m.metadataB)

def joint (m : Model) : ℚ := m.p11

def Identifiable (T : Model → ℚ) : Prop :=
  ∀ m n, obs m = obs n → T m = T n

/-- Binary detection embedded as a two-feature count row with total depth one. -/
def countBlock (b : Bool) : ℕ × ℕ := if b then (1, 0) else (0, 1)

theorem countBlock_depth (b : Bool) : (countBlock b).1 + (countBlock b).2 = 1 := by
  cases b <;> rfl

theorem countBlock_first (b : Bool) : (countBlock b).1 = if b then 1 else 0 := by
  cases b <;> rfl

/-- Pushforward of four equally likely exogenous outcomes through two Boolean equations. -/
def mass (x y : Fin 4 → Bool) (a b : Bool) : ℚ :=
  ∑ i : Fin 4, if x i = a ∧ y i = b then (1 / 4 : ℚ) else 0

def x (i : Fin 4) : Bool := decide (2 ≤ i.val)
def independentY (i : Fin 4) : Bool := decide (i.val % 2 = 1)
def dependentY (i : Fin 4) : Bool := x i

def independent : Model where
  p00 := mass x independentY false false
  p01 := mass x independentY false true
  p10 := mass x independentY true false
  p11 := mass x independentY true true
  h00 := by norm_num [mass, x, independentY, Fin.sum_univ_succ]
  h01 := by norm_num [mass, x, independentY, Fin.sum_univ_succ]
  h10 := by norm_num [mass, x, independentY, Fin.sum_univ_succ]
  h11 := by norm_num [mass, x, independentY, Fin.sum_univ_succ]
  total := by norm_num [mass, x, independentY, Fin.sum_univ_succ]
  guidance := 0
  depthA := 1
  depthB := 1
  metadataA := 0
  metadataB := 0

def dependent : Model where
  p00 := mass x dependentY false false
  p01 := mass x dependentY false true
  p10 := mass x dependentY true false
  p11 := mass x dependentY true true
  h00 := by norm_num [mass, x, dependentY, Fin.sum_univ_succ]
  h01 := by norm_num [mass, x, dependentY, Fin.sum_univ_succ]
  h10 := by norm_num [mass, x, dependentY, Fin.sum_univ_succ]
  h11 := by norm_num [mass, x, dependentY, Fin.sum_univ_succ]
  total := by norm_num [mass, x, dependentY, Fin.sum_univ_succ]
  guidance := 0
  depthA := 1
  depthB := 1
  metadataA := 0
  metadataB := 0

/-- A strictly positive counterexample generated by eight uniform outcomes. -/
def x8 (i : Fin 8) : Bool := decide (4 ≤ i.val)
def noise8 (i : Fin 8) : Bool := decide (i.val % 4 = 0)
def equation8 (a : Bool) (i : Fin 8) : Bool := xor a (noise8 i)
def mass8 (a b : Bool) : ℚ :=
  ∑ i : Fin 8, if x8 i = a ∧ equation8 (x8 i) i = b then (1 / 8 : ℚ) else 0

theorem positive_scm_table :
    mass8 false false = 3/8 ∧ mass8 false true = 1/8 ∧
    mass8 true false = 1/8 ∧ mass8 true true = 3/8 := by
  norm_num [mass8, x8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]

def positiveDependent : Model where
  p00 := mass8 false false
  p01 := mass8 false true
  p10 := mass8 true false
  p11 := mass8 true true
  h00 := by norm_num [mass8, x8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]
  h01 := by norm_num [mass8, x8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]
  h10 := by norm_num [mass8, x8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]
  h11 := by norm_num [mass8, x8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]
  total := by norm_num [mass8, x8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]
  guidance := 0
  depthA := 1
  depthB := 1
  metadataA := 0
  metadataB := 0

theorem positive_same_observation : obs independent = obs positiveDependent := by
  norm_num [obs, independent, positiveDependent, mass, x, independentY, mass8, x8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]

theorem positive_different_joint : joint independent ≠ joint positiveDependent := by
  norm_num [joint, independent, positiveDependent, mass, x, independentY, mass8, x8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]

def intervention8 (a : Bool) : ℚ :=
  ∑ i : Fin 8, if equation8 a i = true then (1 / 8 : ℚ) else 0

theorem positive_scm_effect : intervention8 true - intervention8 false = 1/2 := by
  norm_num [intervention8, equation8, noise8, Fin.sum_univ_succ, Bool.xor]

/-- Structural equations after replacing X by the intervention value. -/
def equation0 (_ : Bool) (i : Fin 4) : Bool := independentY i
def equation1 (a : Bool) (_ : Fin 4) : Bool := a

def interventionProb (f : Bool → Fin 4 → Bool) (a : Bool) : ℚ :=
  ∑ i : Fin 4, if f a i = true then (1 / 4 : ℚ) else 0

def effect (f : Bool → Fin 4 → Bool) : ℚ :=
  interventionProb f true - interventionProb f false

theorem structural_pushforward :
    (∀ i, equation0 (x i) i = independentY i) ∧
    (∀ i, equation1 (x i) i = dependentY i) := by
  constructor <;> intro i <;> rfl

theorem different_effect : effect equation0 = 0 ∧ effect equation1 = 1 := by
  norm_num [effect, interventionProb, equation0, equation1, independentY, Fin.sum_univ_succ]

/-- Functional dependence on X with all other inputs held fixed. -/
def directParent (f : Bool → Fin 4 → Bool) : Prop :=
  ∃ i, f false i ≠ f true i

theorem different_direct_parent : ¬ directParent equation0 ∧ directParent equation1 := by
  constructor
  · rintro ⟨i, h⟩
    exact h rfl
  · exact ⟨0, by decide⟩

theorem same_observation : obs independent = obs dependent := by
  norm_num [obs, independent, dependent, mass, x, independentY, dependentY, Fin.sum_univ_succ]

theorem different_joint : joint independent ≠ joint dependent := by
  norm_num [joint, independent, dependent, mass, x, independentY, dependentY, Fin.sum_univ_succ]

theorem joint_not_identifiable : ¬ Identifiable joint := by
  intro h
  exact different_joint (h independent dependent same_observation)

theorem no_deterministic_recovery (algorithm : (ℚ × ℚ × ℕ × ℕ × ℕ × ℕ × ℕ) → ℚ) :
    ¬ (∀ m, algorithm (obs m) = joint m) := by
  intro h
  apply different_joint
  calc
    joint independent = algorithm (obs independent) := (h independent).symm
    _ = algorithm (obs dependent) := congrArg algorithm same_observation
    _ = joint dependent := h dependent

/-- Exact sharp binary coupling set, represented by its four masses. -/
theorem frechet (p q r : ℚ) :
    (∃ m : Model, m.p10 + m.p11 = p ∧ m.p01 + m.p11 = q ∧ m.p11 = r) ↔
      max 0 (p + q - 1) ≤ r ∧ r ≤ min p q := by
  constructor
  · rintro ⟨m, hp, hq, hr⟩
    constructor
    · apply max_le
      · linarith [m.h11]
      · linarith [m.h00, m.total]
    · apply le_min <;> linarith [m.h10, m.h01]
  · rintro ⟨hl, hu⟩
    have h0 : 0 ≤ r := le_trans (le_max_left _ _) hl
    have h1 : p + q - 1 ≤ r := le_trans (le_max_right _ _) hl
    have h2 : r ≤ p := le_trans hu (min_le_left _ _)
    have h3 : r ≤ q := le_trans hu (min_le_right _ _)
    refine ⟨⟨1 - p - q + r, q - r, p - r, r, ?_, ?_, ?_, h0, ?_, 0, 1, 1, 0, 0⟩, ?_, ?_, rfl⟩ <;> dsimp <;> linarith

/-- Binary independence is a sufficient, explicit completion assumption. -/
theorem independence_identifies (m n : Model)
    (hm : m.p11 = (m.p10 + m.p11) * (m.p01 + m.p11))
    (hn : n.p11 = (n.p10 + n.p11) * (n.p01 + n.p11))
    (h : obs m = obs n) : joint m = joint n := by
  have hp : m.p10 + m.p11 = n.p10 + n.p11 := congrArg Prod.fst h
  have hq : m.p01 + m.p11 = n.p01 + n.p11 := congrArg (fun z => z.2.1) h
  change m.p11 = n.p11
  rw [hm, hn, hp, hq]

/-- Independent binary completion exists for any two probability margins. -/
theorem independence_completion_exists (p q : ℚ)
    (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∃ m : Model, m.p10 + m.p11 = p ∧ m.p01 + m.p11 = q ∧
      m.p11 = (m.p10 + m.p11) * (m.p01 + m.p11) := by
  have hprod : 0 ≤ (1 - p) * (1 - q) := mul_nonneg (by linarith) (by linarith)
  have hleft : max 0 (p + q - 1) ≤ p * q := by
    apply max_le
    · exact mul_nonneg hp0 hq0
    · nlinarith
  have hright : p * q ≤ min p q := by
    apply le_min <;> nlinarith [mul_nonneg hp0 (sub_nonneg.mpr hq1), mul_nonneg hq0 (sub_nonneg.mpr hp1)]
  obtain ⟨m, hm1, hm2, hm3⟩ := (frechet p q (p*q)).mpr ⟨hleft, hright⟩
  exact ⟨m, hm1, hm2, by rw [hm1, hm2]; exact hm3⟩

/-- With binary margins and independence all four cells agree. -/
theorem independence_complete_table (m n : Model)
    (hm : m.p11 = (m.p10 + m.p11) * (m.p01 + m.p11))
    (hn : n.p11 = (n.p10 + n.p11) * (n.p01 + n.p11))
    (h : obs m = obs n) :
    m.p00 = n.p00 ∧ m.p01 = n.p01 ∧ m.p10 = n.p10 ∧ m.p11 = n.p11 := by
  have h11 := independence_identifies m n hm hn h
  change m.p11 = n.p11 at h11
  have hp : m.p10 + m.p11 = n.p10 + n.p11 := congrArg Prod.fst h
  have hq : m.p01 + m.p11 = n.p01 + n.p11 := congrArg (fun z => z.2.1) h
  constructor
  · linarith [m.total, n.total]
  constructor
  · linarith
  constructor
  · linarith
  · exact h11

/-- If a forced binary decision has common output probability q, one error is at least 1/2. -/
theorem randomized_binary_error (q : ℚ) : (1 / 2 : ℚ) ≤ max q (1 - q) := by
  by_cases h : q ≤ 1 / 2
  · exact le_trans (by linarith : (1 / 2 : ℚ) ≤ 1 - q) (le_max_right _ _)
  · exact le_trans (by linarith : (1 / 2 : ℚ) ≤ q) (le_max_left _ _)

/-- The two indexed SCMs connect their structural equations to observed models. -/
def scmModel (b : Bool) : Model := if b then dependent else independent
def scmEffect (b : Bool) : ℚ := effect (if b then equation1 else equation0)
def scmParent (b : Bool) : Prop := directParent (if b then equation1 else equation0)

theorem scm_nonidentification :
    obs (scmModel false) = obs (scmModel true) ∧
    scmEffect false ≠ scmEffect true ∧ ¬ scmParent false ∧ scmParent true := by
  simp only [scmModel, scmEffect, scmParent, Bool.false_eq_true, if_false, if_true]
  exact ⟨same_observation, by rw [different_effect.1, different_effect.2]; norm_num,
    different_direct_parent.1, different_direct_parent.2⟩

/-- A randomized decision rule is specified by its probability of output 1. -/
theorem randomized_countermodel_error
    (algorithm : (ℚ × ℚ × ℕ × ℕ × ℕ × ℕ × ℕ) → ℚ) :
    (1 / 2 : ℚ) ≤ max (algorithm (obs independent)) (1 - algorithm (obs dependent)) := by
  rw [← same_observation]
  exact randomized_binary_error _

