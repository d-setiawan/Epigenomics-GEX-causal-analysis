# =============================================================================
# Tracked: source, configs, manifests, and curated write-ups.
# Not tracked: raw inputs, generated runs, and download caches.
# =============================================================================

# --- Empirical data ----------------------------------------------------------
# Raw sequencing inputs (large, local). ADT/HTO count tables and chromsizes stay
# tracked; only the bulky fragment files are ignored.
pipelines/empirical/data/raw/*/*_histone_fragments.tsv
pipelines/empirical/data/raw/*/*_histone_fragments.tsv.gz
pipelines/empirical/data/raw/*/*_fragments.tsv
pipelines/empirical/data/raw/*/*_fragments.tsv.gz

# Downloaded GEX inputs (large local files)
pipelines/empirical/data/raw/GexData/

# Per-mark preprocessing products (regenerate with the data scripts)
pipelines/empirical/data/outputs/

# Downloaded external evidence databases. The evaluation stage has rebuild scripts.
pipelines/empirical/data/raw/external/eperturbdb/*
!pipelines/empirical/data/raw/external/eperturbdb/.gitkeep
pipelines/empirical/data/raw/external/re2g/
pipelines/empirical/data/raw/external/chains/
pipelines/empirical/data/raw/external/pchic/
pipelines/empirical/data/raw/external/eqtl/
pipelines/empirical/data/raw/external/eqtl_tcell/

# --- Empirical integration ---------------------------------------------------
# Each run is isolated; workspace is a generated symlink view of empirical data.
pipelines/empirical/integration/runs/*
!pipelines/empirical/integration/runs/README.md
pipelines/empirical/integration/workspace/
pipelines/empirical/integration/logs/
pipelines/empirical/integration/comparisons/

# --- Empirical analysis ------------------------------------------------------
pipelines/empirical/analysis/outputs/*
!pipelines/empirical/analysis/outputs/.gitkeep

# --- Empirical evaluation ----------------------------------------------------
# The curated evidence tables behind the results write-ups (peak_peak_pairs.tsv,
# peak_tf_chip.tsv, peak_tf_motifs.tsv, *_summary.json) ARE tracked — they are
# small and are what the claims in results/ rest on.
# Ignored: the download cache and the per-run outputs of repeated searches.
pipelines/empirical/evaluation/outputs/external/cache/
pipelines/empirical/evaluation/outputs/bootstrap_stability/
pipelines/empirical/evaluation/outputs/graph_stability/
pipelines/empirical/evaluation/outputs/null_calibration/

# Simulation inputs and generated run artifacts are large and reproducible.
pipelines/simulation/aggregation_identifiability/outputs/
pipelines/simulation/unpaired_multimodal/outputs/
pipelines/simulation/unpaired_multimodal/runs/
pipelines/simulation/unpaired_multimodal/worlds/
# Retain small protocols, audit sources and result summaries for the exact-model studies.
pipelines/simulation/integration_recoverability/runs/*
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/
pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/*
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/*.md
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/*.tsv
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/*.py
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/*seal.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/*summary.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/*manifest.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/protocol.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/*REVIEW.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/FINAL_CHECKS.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/baseline_source_pins.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/resources.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/symmetry_control.json
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/recovery.png
!pipelines/simulation/integration_recoverability/runs/count_transport_*_v1/recovery.svg

