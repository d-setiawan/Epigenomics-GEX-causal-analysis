# =============================================================================
# Tracked: source (scripts/), configs, manifests, and write-ups (results/, docs/).
# Not tracked: raw inputs, run outputs, download caches — all regenerable from
# the scripts in each section.
# =============================================================================

# --- Data/ -------------------------------------------------------------------
# Raw sequencing inputs (large, local). ADT/HTO count tables and chromsizes stay
# tracked; only the bulky fragment files are ignored.
Data/raw/*/*_histone_fragments.tsv
Data/raw/*/*_histone_fragments.tsv.gz
Data/raw/*/*_fragments.tsv
Data/raw/*/*_fragments.tsv.gz

# Downloaded GEX inputs (large local files)
Data/raw/GexData/

# Per-mark preprocessing products (regenerate with Data/scripts/)
Data/outputs/

# Downloaded external evidence databases. Each regenerates from an
# Evaluation/scripts/build_*_support.py builder.
Data/raw/external/eperturbdb/*
!Data/raw/external/eperturbdb/.gitkeep
Data/raw/external/re2g/
Data/raw/external/chains/
Data/raw/external/pchic/
Data/raw/external/eqtl/
Data/raw/external/eqtl_tcell/

# --- Integration/ ------------------------------------------------------------
# Workspace symlinks, run outputs, logs.
# Rebuild with Integration/scripts/setup_integration_workspace.py
Integration/outputs/

# --- CausalDiscovery/ --------------------------------------------------------
CausalDiscovery/outputs/*
!CausalDiscovery/outputs/.gitkeep

# --- Evaluation/ -------------------------------------------------------------
# The curated evidence tables behind the results write-ups (peak_peak_pairs.tsv,
# peak_tf_chip.tsv, peak_tf_motifs.tsv, *_summary.json) ARE tracked — they are
# small and are what the claims in results/ rest on.
# Ignored: the download cache and the per-run outputs of repeated searches.
Evaluation/outputs/external/cache/
Evaluation/outputs/bootstrap_stability/
Evaluation/outputs/graph_stability/
Evaluation/outputs/null_calibration/

# --- docs/ -------------------------------------------------------------------
# Reference PDFs (54M, third-party)
docs/papers/

# LaTeX build intermediates (keep .tex/.pdf/.md and figures under docs/reports/)
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.out

# --- misc --------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
graphify-out/
sandbox_outputs/
hs_err_pid*.log

# Windows "mark of the web" metadata files
*:Zone.Identifier
