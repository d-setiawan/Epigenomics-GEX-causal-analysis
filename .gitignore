# Raw fragment files (large local inputs)
Data/*/*_histone_fragments.tsv
Data/*/*_histone_fragments.tsv.gz
Data/*/*_fragments.tsv
Data/*/*_fragments.tsv.gz

# Python runtime/cache artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Local graphify index and reports
graphify-out/

# Pipeline outputs (all histone modification folders)
Data/*/outputs/

# Downloaded GEX inputs (large local files)
Data/GexData/

# Downloaded external evidence databases
Data/external/eperturbdb/*
!Data/external/eperturbdb/.gitkeep

# Downloaded ENCODE-rE2G monocyte gene-link tables (regenerate with build_re2g_gene_link_support.py)
Data/external/re2g/

# liftOver chain files (auto-downloaded from UCSC by scripts/liftover.py)
Data/external/chains/

# Downloaded external-evidence caches (ENCODE portal / SCREEN; regenerated on demand)
CausalDiscovery/evaluation/external/cache/encode_*
CausalDiscovery/evaluation/external/cache/*.bed.gz

# Sandbox analysis outputs
sandbox_outputs/

# Integration runtime artifacts (keep scripts/configs/manifests tracked)
integration/workspace/
integration/outputs/
integration/logs/

# Causal discovery run outputs
CausalDiscovery/outputs/*
!CausalDiscovery/outputs/.gitkeep

# LaTeX build intermediates (keep .tex/.pdf/.md and figures under notes/)
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.out

# Windows "mark of the web" metadata files
*:Zone.Identifier
